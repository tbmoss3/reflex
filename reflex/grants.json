{
  "version": "0.1-L0-OWNED-DO-NOT-MODIFY",
  "note": "Static tool grants file. The harness READS this; nothing (including the nightly trainer or any model) may write it. Operator actions not listed here are refused at L0.",
  "operator": {
    "allowed_tools": ["write_file", "patch", "terminal"],
    "terminal_whitelist": ["ls", "cat", "grep", "rg", "find", "git status", "git diff", "git log", "python --version", "pip list"],
    "forbidden_patterns": ["payroll", "banking", "invoice payment", "cut check", "sage", "publish", "post to", "send_email", "rm -rf /", "deploy", "push", "merge --no-review"]
  },
  "research": {
    "allowed_tools": ["web_search", "web_extract", "read_file", "search_files"],
    "forbidden": ["write_file", "patch", "terminal"]
  },
  "report": {
    "allowed_tools": ["render_template"],
    "forbidden": ["*"]
  },
  "judge": {
    "allowed_tools": ["read_file", "search_files"],
    "escalate_to_human": ["external communications", "money/pay/banking", "client data beyond own repos", "irreversible actions"]
  }
}
